{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tangerg/flow/schema/workflow-graph.json",
  "title": "Flow workflow graph",
  "description": "A flat directed acyclic graph of registered leaf nodes.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": ["array", "null"],
      "description": "Nodes in stable declaration order.",
      "items": { "$ref": "#/$defs/node" }
    },
    "concurrency": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum nodes running concurrently across the graph; zero is unbounded."
    }
  },
  "required": ["nodes"],
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "description": "A path into a graph node's stored value or an external seed value.",
      "properties": {
        "nodeID": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$",
          "description": "An RFC 6901 JSON Pointer below the node value."
        }
      },
      "required": ["nodeID", "path"],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "description": "Input references wired by port name.",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/ref" }
    },
    "gate": {
      "type": "object",
      "description": "A routing output that must select this node.",
      "properties": {
        "nodeID": { "type": "string", "minLength": 1 },
        "outlet": { "type": "string", "minLength": 1 }
      },
      "required": ["nodeID", "outlet"],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/ref" },
        "inputs": { "$ref": "#/$defs/inputs" },
        "config": {},
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "when": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gate" },
          "uniqueItems": true
        },
        "trigger": {
          "const": "any",
          "description": "Run when any gate matches; omission requires every gate."
        }
      },
      "required": ["id", "type"],
      "dependentRequired": {
        "trigger": ["when"]
      },
      "additionalProperties": false
    }
  }
}
