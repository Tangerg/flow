{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tangerg/flow/schema/workflow-graph.json",
  "title": "Flow workflow graph",
  "description": "A flat directed acyclic graph of registered, Store-sealed nodes.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": ["array", "null"],
      "description": "Nodes in stable declaration order.",
      "items": { "$ref": "#/$defs/node" }
    },
    "concurrency": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum nodes running concurrently across the graph; zero is unbounded. The value must fit the engine platform's Go int."
    }
  },
  "required": ["nodes"],
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "description": "A path into a graph node's stored value or an external seed value.",
      "properties": {
        "nodeID": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$",
          "description": "An RFC 6901 JSON Pointer below the node value."
        }
      },
      "required": ["nodeID", "path"],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "description": "Input references wired by port name.",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/ref" }
    },
    "gate": {
      "type": "object",
      "description": "One routing decision considered when selecting this node.",
      "properties": {
        "nodeID": { "type": "string", "minLength": 1 },
        "outlet": { "type": "string", "minLength": 1 }
      },
      "required": ["nodeID", "outlet"],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "inputs": { "$ref": "#/$defs/inputs" },
        "config": {},
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "when": {
          "type": "array",
          "description": "Routing conditions. An empty array is equivalent to omission unless trigger is any.",
          "items": { "$ref": "#/$defs/gate" },
          "uniqueItems": true
        },
        "trigger": {
          "const": "any",
          "description": "After every gate source completes, run when any gate matches; omission requires every gate."
        }
      },
      "required": ["id", "type"],
      "dependentRequired": {
        "trigger": ["when"]
      },
      "allOf": [
        {
          "if": {
            "properties": { "trigger": { "const": "any" } },
            "required": ["trigger"]
          },
          "then": {
            "properties": {
              "when": { "minItems": 1 }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
